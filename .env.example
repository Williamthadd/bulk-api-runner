# Copy to .env and fill in. Never commit .env.

# --- MySQL container (docker compose) ---
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=bulk_runner
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_PORT=3307

# --- App database connection (dedicated user, not root) ---
# Must match the values above, e.g.
# DATABASE_URL=mysql+pymysql://user:pass@127.0.0.1:3307/bulk_runner?charset=utf8mb4
DATABASE_URL=

# --- Test database (docker compose --profile test up -d db-test) ---
MYSQL_TEST_DATABASE=bulk_runner_test
MYSQL_TEST_PORT=3308
# TEST_DATABASE_URL=mysql+pymysql://user:pass@127.0.0.1:3308/bulk_runner_test?charset=utf8mb4
TEST_DATABASE_URL=

# --- App settings (optional, defaults shown) ---
APP_PORT=8765
SCRIPT_TIMEOUT_SECONDS=60
SCRIPT_MEMORY_LIMIT_MB=1024
UPLOAD_MAX_MB=10
UPLOAD_TTL_HOURS=24
RETENTION_MAX_RUNS=20
RETENTION_DAYS=30
